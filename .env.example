DISCORD_TOKEN=

# GroupMe user access token (https://dev.groupme.com/applications -> Access Token).
# Required for poll mode, group/bot lookups, image uploads, and posting as the user
# (topic bridges, and groups that refuse bot creation).
GROUPME_ACCESS_TOKEN=

# "poll" reads group history on a timer and needs no public URL.
# "webhook" receives GroupMe bot callbacks in real time and needs a public URL.
GROUPME_MODE=poll

# Optional (defaults shown)
GROUPME_API_BASE=https://api.groupme.com/v3
# Used to re-host Discord images before posting them to GroupMe.
GROUPME_IMAGE_API=https://image.groupme.com
GROUPME_POLL_SECONDS=10
# Most poll cycles fetch only this many newest messages; every
# GROUPME_POLL_BACKFILL_SECONDS the poll fetches GROUPME_HISTORY_LIMIT instead.
GROUPME_POLL_RECENT_LIMIT=5
GROUPME_POLL_BACKFILL_SECONDS=300
# Widest message window a poll fetches (also the window used for deletion checks).
GROUPME_HISTORY_LIMIT=25
GROUPME_REQUEST_DELAY_SECONDS=1
# Mirror deletions: a deleted Discord message removes its GroupMe copy, and a
# GroupMe message that disappears takes its mirrored Discord copy with it.
SYNC_DELETIONS=true
# GroupMe sends no delete callback, so linked messages are compared with the newest
# page of each bridged conversation on this interval.
GROUPME_DELETE_CHECK_SECONDS=300
# Loopback keeps the callback server off the internet: the ngrok tunnel forwards to
# localhost. Use 0.0.0.0 only when a proxy on another host has to reach the port.
GROUPME_WEBHOOK_HOST=127.0.0.1
GROUPME_WEBHOOK_PORT=8085
GROUPME_WEBHOOK_PATH=/groupme/callback
# Public base URL used to print the bot callback URL in /bridge add (webhook mode).
# Leave empty when NGROK_ENABLED=true: the tunnel URL is used instead.
GROUPME_PUBLIC_URL=

# Expose the callback server through ngrok (webhook mode only).
NGROK_ENABLED=false
# Read from the environment by the ngrok SDK when NGROK_ENABLED=true.
NGROK_AUTHTOKEN=
# Optional reserved domain, e.g. paddling-unmoved-equator.ngrok-free.dev
NGROK_DOMAIN=

DB_PATH=catbird.db
# Name/avatar for bots that /bridge add creates automatically.
# The avatar can be a file in the repo (relative to bot.py), e.g. assets/avatar.png.
# A local file is uploaded fresh for every bot; GroupMe deletes hosted avatars when
# a bot using them is removed, so URLs are not reused.
GROUPME_BOT_NAME=Catbird Bridge
GROUPME_BOT_AVATAR_PATH=
# Optional i.groupme.com URL, used only when GROUPME_BOT_AVATAR_PATH is empty.
GROUPME_BOT_AVATAR_URL=
# Images sent to GroupMe are downscaled/re-encoded before upload.
IMAGE_MAX_DIMENSION=2048
IMAGE_JPEG_QUALITY=85
IMAGE_UPLOAD_LIMIT_BYTES=8388608
# Optional: sync slash commands to a single guild instantly.
DISCORD_GUILD_ID=
VERBOSE_LOGGING=false
# Log every raw GroupMe callback (message content included) to troubleshoot payload fields.
LOG_GROUPME_PAYLOADS=false
GROUPME_PAYLOAD_LOG=groupme_payloads.jsonl
