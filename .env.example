DISCORD_TOKEN=

# GroupMe user access token (https://dev.groupme.com/applications -> Access Token).
# Required for poll mode and for group name/bot lookups.
GROUPME_ACCESS_TOKEN=

# "poll" reads group history on a timer and needs no public URL.
# "webhook" receives GroupMe bot callbacks in real time and needs a public URL.
GROUPME_MODE=poll

# Optional (defaults shown)
GROUPME_API_BASE=https://api.groupme.com/v3
# Used to re-host Discord images before posting into a topic.
GROUPME_IMAGE_API=https://image.groupme.com
GROUPME_POLL_SECONDS=10
GROUPME_REQUEST_DELAY_SECONDS=1
GROUPME_WEBHOOK_HOST=0.0.0.0
GROUPME_WEBHOOK_PORT=8085
GROUPME_WEBHOOK_PATH=/groupme/callback
# Public base URL used to print the bot callback URL in /bridge add (webhook mode).
# Leave empty when NGROK_ENABLED=true: the tunnel URL is used instead.
GROUPME_PUBLIC_URL=

# Expose the callback server through ngrok (webhook mode only).
NGROK_ENABLED=false
# Read from the environment by the ngrok SDK when NGROK_ENABLED=true.
NGROK_AUTHTOKEN=
# Optional reserved domain, e.g. paddling-unmoved-equator.ngrok-free.dev
NGROK_DOMAIN=

DB_PATH=catbird.db
# Name/avatar for bots that /bridge add creates automatically.
# The avatar URL must be i.groupme.com; other origins are ignored by GroupMe.
# Leave the avatar empty to use the Discord bot's own picture.
GROUPME_BOT_NAME=Catbird Bridge
GROUPME_BOT_AVATAR_URL=
# Images posted into a GroupMe topic are downscaled/re-encoded before upload.
IMAGE_MAX_DIMENSION=2048
IMAGE_JPEG_QUALITY=85
IMAGE_UPLOAD_LIMIT_BYTES=8388608
# Optional: sync slash commands to a single guild instantly.
DISCORD_GUILD_ID=
VERBOSE_LOGGING=false
# Log every raw GroupMe callback (message content included) to troubleshoot payload fields.
LOG_GROUPME_PAYLOADS=false
GROUPME_PAYLOAD_LOG=groupme_payloads.jsonl
